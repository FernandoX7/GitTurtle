[package]
name = "gpui-pre-macros"
version = "0.3.4"
edition = { workspace = true }
publish = true
license = "Apache-2.0"
description = "Macros used by gpui (gpui-pre snapshot of zed@6916400)"
repository = "https://github.com/zed-industries/zed"

[package.metadata.gpui-pre]
zed-crate = "gpui_macros"
zed-version = "0.1.0"
zed-rev = "69164008341295ad481bb11c0334a712ca8c23e3"

[lib]
path = "src/gpui_macros.rs"
proc-macro = true
doctest = true
name = "gpui_macros"

[features]
inspector = []

[dependencies]
heck = { workspace = true }
proc-macro2 = { workspace = true }
quote = { workspace = true }
syn = { workspace = true }
proc-macro-crate = "3"

[lints]
workspace = true
