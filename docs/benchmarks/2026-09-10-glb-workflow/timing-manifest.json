    "clip_index": 0,
    "timestamp_policy": "Each phase resets its sample index; selected clip timestamps are duration*(index mod 61)/60, including endpoints. No-animation inputs use zero and evaluate_ms records only branch/timer overhead.",
    "camera": "Fit authored default scene once per row, Isometric orthographic; same camera for static and animated frames. Camera fitting excluded.",
    "cache": "Each process reads input once before all timing rows. Input bytes remain resident; each row decodes a fresh scene. No application cache. First attempt is not a cold-filesystem or cold-system benchmark. An untimed metadata/default-and-midpoint probe precedes each fixture process; no system cache purge is performed.",
    "decode": "Fresh captured-byte decode, appearance/image/mipmap preparation, default skin/morph evaluation and retained source preparation.",
    "static_720": "CPU render of authored default scene into fresh720 RGBA output.",
    "first_usable_cpu": "Per-row decode_ms + static_720_ms; sum of two measured CPU phases, excludes intervening camera fitting and allocation destruction. Not native first-frame latency.",
    "evaluation": "Evaluate clip0 on the retained source at that row timestamp; expensive geometry evaluation and bounds preparation included.",
    "frames": "Fresh360 and720 CPU renders from evaluated pose, with unchanged default-fit camera.",
    "derived_sums": "evaluate_plus_frame metrics are per-row evaluation+render sums, not a directly contiguous timer or UI delivery measurement.",
    "excluded": "File I/O, camera fitting, output destruction, app scheduling, native widget/render-image conversion, GPU upload/completion and OS presentation.",
    "percentiles": "Nearest rank over100 measured rows only; first/warmup rows and outliers remain in raw TSV.",
    "rss": "Three separate processes per input, each /usr/bin/time -l bench_model_animation INPUT 1 0 0 (one first plus one measured row). Darwin maximum resident set size is recorded in bytes. Includes process/loader/allocator/input bytes and sequential decode/evaluation/render peaks. Static and evaluated scenes share appearance/evaluator storage, so reported scene_bytes and pose_bytes must not be added as distinct allocations.",
    "rss_baseline": "Three separate usage-only invocations of the same release binary with no arguments and expected exit1. This establishes minimal process/argument/error handling overhead; it is not subtracted to infer isolated decoder allocation.",
    "limitations": "Single host, ordinary desktop background load; native macOS workflow validation could overlap. No CPU isolation or thermal control. Release builds and reference/corpus CPU scans had finished before the series. Process RSS is not GPU memory, native application memory, or a proof of an overall memory cap. No speedup or other-platform claim.",
    "reproduce_timing": "Build the recorded release preview example, then run bench_model_animation INPUT 100 3 0. Retain all104 rows; replace the first comment executable path with its hash when publishing.",
    "reproduce_rss": "Run /usr/bin/time -l bench_model_animation INPUT 1 0 0 in three separate processes per fixture, then /usr/bin/time -l bench_model_animation without arguments three times for usage-only baseline."
  },
