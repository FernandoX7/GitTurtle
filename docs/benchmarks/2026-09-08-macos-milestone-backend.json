  "fixture_generator_python": "from pathlib import Path\nimport hashlib, json, os, subprocess, tempfile\nbase = Path(tempfile.mkdtemp(prefix='milestone-backend-', dir='/tmp')).resolve()\nrepo = base / 'work'\nrepo.mkdir()\ndef git(*args, date=None):\n    env = os.environ.copy()\n    env.update(GIT_CONFIG_NOSYSTEM='1', GIT_CONFIG_GLOBAL=str(base / 'no-global-config'))\n    if date:\n        env.update(GIT_AUTHOR_DATE=date, GIT_COMMITTER_DATE=date)\n    return subprocess.run(['git', '-C', str(repo), *map(str, args)], env=env, check=True, capture_output=True, text=True).stdout.strip()\ngit('init', '-b', 'main')\nfor key, value in [('user.name', 'Milestone fixture'), ('user.email', 'fixture@example.invalid'), ('commit.gpgsign', 'false'), ('tag.gpgSign', 'false'), ('core.hooksPath', '.git/hooks'), ('core.autocrlf', 'false')]:\n    git('config', key, value)\n(repo / 'src').mkdir()\nlines = [f'pub const VALUE_{i:03}: usize = {i};\\n' for i in range(512)]\ntracked = Path('src/original.rs')\n(repo / tracked).write_text(''.join(lines))\nfor i in range(300):\n    file = repo / f'files/group-{i//30:02}/item-{i:03}.txt'\n    file.parent.mkdir(parents=True, exist_ok=True)\n    file.write_text(f'Baseline {i}\\n')\n(repo / 'scratch').mkdir()\n(repo / 'scratch/keep.txt').write_text('Tracked neighbor stays tracked\\n')\n(repo / '.gitignore').write_bytes(b'# Shared fixture rules\\r\\nignored-existing/\\r\\n')\ngit('add', '--all')\ngit('commit', '-m', 'Fixture baseline', date='2026-09-01T00:00:00+00:00')\ncommits = [git('rev-parse', 'HEAD')]\nfor n in range(1, 129):\n    if n == 64:\n        new = Path('src/renamed.rs')\n        git('mv', tracked, new)\n        tracked = new\n    selected = 63 if n % 2 == 0 else (n * 37) % 512\n    lines[selected] = f'pub const VALUE_{selected:03}: usize = {1000+n};\\n'\n    (repo / tracked).write_text(''.join(lines))\n    git('add', tracked)\n    git('commit', '-m', f'Fixture revision {n:03}', date=f'2026-09-01T00:{n//60:02}:{n%60:02}+00:00')\n    commits.append(git('rev-parse', 'HEAD'))\nfor n in range(256):\n    git('tag', f'fixture/light-{n:03}', commits[n % len(commits)])\nfor n in range(128):\n    git('tag', '-a', f'fixture/annotated-{n:03}', commits[n % len(commits)], '-m', f'Fixture annotated tag {n:03}', date='2026-09-02T00:00:00+00:00')\nlines[15] = 'pub const VALUE_015: usize = 9000;\\n'\n(repo / tracked).write_text(''.join(lines))\ngit('add', tracked)\nlines[31] = 'pub const VALUE_031: usize = 9001;\\n'\n(repo / tracked).write_text(''.join(lines) + '// Local addition one\\n// Local addition two\\n// Local addition three\\n// Local addition four\\n')\nfor n in range(60):\n    file = Path(f'files/group-{n//30:02}/item-{n:03}.txt')\n    (repo / file).write_text(f'Staged candidate {n}\\n')\n    if n < 30:\n        git('add', file)\n    if 15 <= n < 45:\n        (repo / file).write_text(f'Further working edit {n}\\n')\nfor n in range(30):\n    (repo / f'scratch/cache[{n}].tmp').write_text(f'Untracked {n}\\n')\nmanifest = {'repository': str(repo), 'head': commits[-1], 'commits': len(commits), 'tracked_files': len(git('ls-files').splitlines()), 'tags': 384, 'annotated_tags': 128, 'selected_committed_path': str(tracked), 'previous_path': 'src/original.rs', 'rename_commit': commits[64], 'selected_line': 64, 'committed_lines': 512, 'working_lines': 516, 'untracked_selected_path': 'scratch/cache[1].tmp', 'status_porcelain': git('status', '--porcelain=v2', '--untracked-files=all'), 'index_sha256': hashlib.sha256((repo / '.git/index').read_bytes()).hexdigest(), 'working_sha256': hashlib.sha256((repo / tracked).read_bytes()).hexdigest(), 'generator_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}\n(base / 'fixture.json').write_text(json.dumps(manifest, indent=2) + '\\n')\nprint(base)\n",
