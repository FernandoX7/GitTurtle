    },
    {
      "code_prefixes": ["crates/theme/", "crates/app/src/appearance.rs", "crates/app/src/appearance/"],
      "docs": [
        "DESIGN.md",
        "docs/design/tokens-and-palettes.md",
        "docs/user-guide.md",
        "website/guides/docs/omarchy-and-themes.html"
      ]
    },
    {
      "code_prefixes": ["crates/diff-model/", "crates/prefs/", "crates/app/src/repository_tabs.rs", "crates/app/src/history_paging.rs", "crates/app/src/worker/"],
      "docs": [
        "docs/architecture.md",
        "crates/app/AGENTS.md",
        "docs/user-guide.md"
      ]
    },
    {
      "code_prefixes": ["crates/github/", "crates/app/src/github_view.rs", "crates/app/src/github_view/"],
      "docs": [
