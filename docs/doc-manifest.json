  "constants": [
    {
      "name": "built_in_themes",
      "source": "crates/theme/src/palette.rs",
      "kind": "regex_int",
      "pattern": "impl ThemeChoice\\s*\\{[\\s\\S]*?pub const ALL:\\s*\\[Self;\\s*(\\d+)\\]",
      "docs": [
        { "path": "README.md", "pattern": "\\b{word_value} built-in\\b", "ignore_case": true },
        { "path": "docs/user-guide.md", "pattern": "\\b{word_value} built-in themes\\b", "ignore_case": true },
        { "path": "website/public/index.html", "pattern": "\\b{value} built-in themes\\b" }
      ]
    },
    {
      "name": "max_custom_themes",
      "source": "crates/theme/src/lib.rs",
      "kind": "rust_const_int",
      "symbol": "MAX_CUSTOM_THEMES",
      "docs": [
        { "path": "README.md", "pattern": "\\bup to {value} themes\\b", "ignore_case": true },
        { "path": "docs/user-guide.md", "pattern": "\\b{value} custom themes\\b" },
        { "path": "website/guides/docs/omarchy-and-themes.html", "pattern": "\\b{value} custom themes\\b" }
      ]
    },
    {
      "name": "max_repository_tabs",
      "source": "crates/app/src/repository_tabs.rs",
      "kind": "rust_const_int",
      "symbol": "MAX_TABS",
      "docs": [
        { "path": "README.md", "pattern": "\\bup to {word_value} repository and worktree tabs\\b", "ignore_case": true },
        { "path": "docs/user-guide.md", "pattern": "\\bup to {word_value} repository/worktree tabs\\b", "ignore_case": true },
        { "path": "docs/user-guide.md", "pattern": "Command-Option-1 through {value}\\b" },
        { "path": "website/guides/docs/first-repository.html", "pattern": "\\bup to {word_value} repositories or linked worktrees in tabs\\b", "ignore_case": true }
      ]
    },
    {
      "name": "history_window_rows",
      "source": "crates/app/src/history_paging.rs",
      "kind": "rust_const_int",
      "symbol": "MAX_WINDOW_ROWS",
      "docs": [
        { "path": "README.md", "pattern": "\\b{comma_value} rows\\b" },
        { "path": "docs/user-guide.md", "pattern": "\\b{comma_value} rows\\b" },
        { "path": "docs/architecture.md", "pattern": "\\b{comma_value} rows\\b" }
      ]
    },
    {
      "name": "history_window_mib",
      "source": "crates/app/src/history_paging.rs",
      "kind": "rust_const_mib",
      "symbol": "MAX_WINDOW_BYTES",
      "docs": [
        { "path": "README.md", "pattern": "\\b{value} MiB\\b" },
        { "path": "docs/user-guide.md", "pattern": "\\b{value} MiB\\b" },
        { "path": "docs/architecture.md", "pattern": "\\b{value} MiB\\b" }
      ]
    },
    {
      "name": "ci_upload_retention_days",
      "source": "scripts/ci/packages.py",
      "kind": "regex_int",
      "pattern": "(?m)^UPLOAD_RETENTION_DAYS\\s*=\\s*(\\d+)",
      "docs": [
        { "path": "docs/ci-artifacts.md", "pattern": "\\b{word_value}-day\\b", "ignore_case": true },
        { "path": "docs/public-launch.md", "pattern": "\\b{word_value}-day\\b", "ignore_case": true }
      ]
    },
    {
      "name": "ci_macos_test_shards",
      "source": "scripts/ci/changes.py",
      "kind": "regex_int",
      "pattern": "\"os\":\\s*\"macos-15\"[^\\n]*\"shards\":\\s*(\\d+)",
      "docs": [
        { "path": "docs/ci.md", "pattern": "Rust tests · macos-15 · 1/{value}" },
        { "path": "docs/releases.md", "pattern": "Rust tests · macos-15 · 1/{value}" }
      ]
    },
    {
      "name": "ci_ubuntu_test_shards",
      "source": "scripts/ci/changes.py",
      "kind": "regex_int",
      "pattern": "\"os\":\\s*\"ubuntu-24\\.04\"[^\\n]*\"shards\":\\s*(\\d+)",
      "docs": [
        { "path": "docs/ci.md", "pattern": "Rust tests · ubuntu-24\\.04 · 1/{value}" },
        { "path": "docs/releases.md", "pattern": "Rust tests · ubuntu-24\\.04 · 1/{value}" }
      ]
    },
    {
      "name": "ci_actionlint_version",
      "source": ".github/workflows/quality.yml",
      "kind": "regex_str",
      "pattern": "actionlint/releases/download/v([0-9]+\\.[0-9]+\\.[0-9]+)/",
      "docs": [
        { "path": "docs/ci.md", "pattern": "actionlint[^\\n]*\\b{value}\\b" }
      ]
    }
  ],
  "known_gaps_sync": [
    {
      "source": "scripts/ci/packages.py",
      "docs": [
        { "path": "docs/ci-artifacts.md", "empty_pattern": "(?:empty `KNOWN_GAPS`|`KNOWN_GAPS`[^\\n]*empty)", "ignore_case": true },
        { "path": "docs/public-launch.md", "empty_pattern": "(?:empty `KNOWN_GAPS`|`KNOWN_GAPS`[^\\n]*empty)", "ignore_case": true }
      ]
    }
  ],
  "workflows_listed_in": [
    "CONTRIBUTING.md"
  ],
  "include_str_roots": [
    "crates"
  ],
  "check_website_guides": true,
  "surface_map": [
    {
      "code_prefixes": ["rust-toolchain.toml", "Cargo.toml", "Cargo.lock"],
      "docs": [
        "README.md",
        "CONTRIBUTING.md",
        "docs/linux.md",
        "docs/user-guide.md",
        "docs/authentication.md",
        "website/guides/reference/install/"
