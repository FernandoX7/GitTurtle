#21=FACE_OUTER_BOUND('',#11,.T.);
#22=FACE_OUTER_BOUND('',#12,.T.);
#23=FACE_OUTER_BOUND('',#13,.T.);
#30=FACE('',(#20));
#31=FACE('',(#21));
#32=FACE('',(#22));
#33=FACE('',(#23));
#40=CLOSED_SHELL('',(#30,#31,#32,#33));
