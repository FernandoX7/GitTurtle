#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

env -u RUSTUP_TOOLCHAIN cargo fmt --all -- --check

if command -v typos >/dev/null 2>&1; then
  typos --format brief
fi

python3 scripts/check-agent-guidance.py

if [ -f scripts/check-docs-sync.py ]; then
  python3 scripts/check-docs-sync.py
fi

if [ -f scripts/dev/check_invariants.py ]; then
  python3 scripts/dev/check_invariants.py
fi

if [ -f scripts/dev/vendor_patch_audit.py ]; then
  python3 scripts/dev/vendor_patch_audit.py
fi

if command -v actionlint >/dev/null 2>&1 || command -v zizmor >/dev/null 2>&1; then
  base_ref="origin/main"
  if ! git rev-parse --verify -q "$base_ref" >/dev/null 2>&1; then
    base_ref="HEAD~1"
  fi
  existing=()
  while IFS= read -r wf; do
    if [ -n "$wf" ] && [ -f "$wf" ]; then
      existing+=("$wf")
    fi
  done < <(git -c core.quotePath=false diff --name-only "$base_ref...HEAD" -- '.github/workflows/*.yml' '.github/workflows/*.yaml' '.github/actions/**/*.yml' 2>/dev/null || true)
  if [ "${#existing[@]}" -gt 0 ]; then
    if command -v actionlint >/dev/null 2>&1; then
      workflows=()
      for wf in "${existing[@]}"; do
        case "$wf" in
          .github/workflows/*) workflows+=("$wf") ;;
        esac
      done
      if [ "${#workflows[@]}" -gt 0 ]; then
        actionlint -shellcheck='' -pyflakes='' "${workflows[@]}"
      fi
    fi
    if command -v zizmor >/dev/null 2>&1; then
      zizmor --offline --min-severity medium .github/workflows .github/actions
    fi
  fi
fi
