pkgbase = gitturtle-bin
	pkgdesc = Fast native Git client for history inspection and everyday Git work
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/FernandoX7/GitTurtle
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = glibc
	depends = libgcc
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	depends = vulkan-driver
	depends = libglvnd
	depends = git
	depends = hicolor-icon-theme
	optdepends = dav1d: AVIF image preview decoding (loaded dynamically in the confined helper)
	optdepends = git-lfs: download Git LFS files on request
	optdepends = github-cli: connect a GitHub account and review pull requests
	optdepends = org.freedesktop.secrets: a keyring that holds the GitHub authorization
	optdepends = xdg-desktop-portal: the folder picker, Open in default app and desktop text settings
	optdepends = xdg-desktop-portal-gtk: a file chooser where the desktop portal has none, as on Hyprland
	optdepends = xdg-utils: open links, and files when no portal answers
	optdepends = glib2: check a file type before Open in default app
	optdepends = fontconfig: fonts for other scripts and the desktop monospace font
	optdepends = openssh: SSH remotes
	optdepends = xdg-terminal-exec: Open repository in terminal
	provides = gitturtle
	conflicts = gitturtle
	options = !strip
	options = !debug
	source_x86_64 = https://github.com/FernandoX7/GitTurtle/releases/download/v0.1.0/GitTurtle-0.1.0-000000000000-linux-x86_64-release.tar.gz
	sha256sums_x86_64 = not-released
	source_aarch64 = https://github.com/FernandoX7/GitTurtle/releases/download/v0.1.0/GitTurtle-0.1.0-000000000000-linux-aarch64-release.tar.gz
	sha256sums_aarch64 = not-released

pkgname = gitturtle-bin
